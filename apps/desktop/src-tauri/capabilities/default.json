{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Permission boundary for the Medical Deid main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/medical-deid-worker",
          "sidecar": true,
          "args": [{ "validator": "^--stdio$" }]
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
