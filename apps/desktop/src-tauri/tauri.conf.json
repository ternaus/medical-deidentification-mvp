{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Medical Deid",
  "version": "0.1.0",
  "identifier": "ai.albumentations.medicaldeid",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Medical Deid",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://localhost:5173 http://127.0.0.1:5173" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": ["icons/icon.png"],
    "resources": { "../../../LICENSE": "LICENSE" },
    "externalBin": ["binaries/medical-deid-worker"]
  }
}
